          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="contract" value="&lt;b&gt;Commit before acknowledgement&lt;/b&gt;&lt;br&gt;Target evidence or durable fragment custody → delivery checkpoint → in-memory acknowledgment&lt;br&gt;Only complete, checksum-verified events become audit rows. Source-coordinate checks deduplicate supported replays." parent="1" vertex="1" style="fontFamily=Helvetica;fontColor=#312D2A;fontSize=13;html=1;whiteSpace=wrap;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=21;">
          <mxGeometry x="40" y="310" width="1510" height="110" as="geometry" />
        </mxCell>
        <mxCell id="key" value="&lt;b&gt;Complete typed record key&lt;/b&gt;&lt;br&gt;{&quot;id&quot;:1042}" parent="1" vertex="1" style="fontFamily=Helvetica;fontColor=#312D2A;fontSize=13;html=1;whiteSpace=wrap;rounded=1;fillColor=#ECF4F1;strokeColor=#467B83;fontSize=21;">
          <mxGeometry x="65" y="490" width="360" height="110" as="geometry" />
        </mxCell>
        <mxCell id="hmac" value="&lt;b&gt;Stable HMAC-SHA256&lt;/b&gt;&lt;br&gt;Source identity + schema + table + key" parent="1" vertex="1" style="fontFamily=Helvetica;fontColor=#312D2A;fontSize=13;html=1;whiteSpace=wrap;rounded=1;fillColor=#ECF4F1;strokeColor=#467B83;fontSize=21;">
          <mxGeometry x="565" y="490" width="490" height="110" as="geometry" />
        </mxCell>
        <mxCell id="lookup" value="&lt;b&gt;Indexed row history&lt;/b&gt;&lt;br&gt;BEFORE / AFTER + event time" parent="1" vertex="1" style="fontFamily=Helvetica;fontColor=#312D2A;fontSize=13;html=1;whiteSpace=wrap;rounded=1;fillColor=#ECF4F1;strokeColor=#467B83;fontSize=21;">
          <mxGeometry x="1190" y="490" width="355" height="110" as="geometry" />
        </mxCell>
        <mxCell id="key-hmac" value="" parent="1" source="key" target="hmac" edge="1" style="fontFamily=Helvetica;fontColor=#312D2A;fontSize=13;html=1;whiteSpace=wrap;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#467B83;strokeWidth=2;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;fontSize=11;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="hmac-lookup" value="" parent="1" source="hmac" target="lookup" edge="1" style="fontFamily=Helvetica;fontColor=#312D2A;fontSize=13;html=1;whiteSpace=wrap;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#467B83;strokeWidth=2;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;fontSize=11;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="note" value="Preserve the Vault key and source identity. JSON numbers and strings remain distinct.&lt;br&gt;A primary-key change can produce separate key histories. Image hashes compare content; they are not the row identity.&lt;br&gt;Public DDL evidence is separate from private Debezium recovery history. DCL needs a separate audit-log collector." parent="1" vertex="1" style="fontFamily=Helvetica;fontColor=#312D2A;fontSize=13;html=1;whiteSpace=wrap;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=21;">
